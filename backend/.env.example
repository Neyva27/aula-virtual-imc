# Plantilla de variables de entorno del backend. Copiar a `.env` y completar.
# El archivo `.env` NUNCA se sube a Git. La aplicación no arranca si falta o es inválida una variable.

# development | test | production
NODE_ENV=development
PORT=3000

# Conexión a MySQL con el usuario exclusivo de la aplicación (nunca root).
DATABASE_URL="mysql://aula_imc:CAMBIAR_ESTA_CLAVE@localhost:3306/aula_imc_dev"
# MySQL 8 sin SSL usa caching_sha2_password: el driver necesita obtener la clave pública del servidor.
# true SOLO si MySQL está en el mismo equipo (localhost); con otro servidor se rechaza y se debe usar SSL.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
# Solo para `prisma migrate dev`.
SHADOW_DATABASE_URL="mysql://aula_imc:CAMBIAR_ESTA_CLAVE@localhost:3306/aula_imc_shadow"
# Solo para `npm run test:db` (pruebas contra MySQL). El nombre de la base debe terminar en _test.
TEST_DATABASE_URL="mysql://aula_imc:CAMBIAR_ESTA_CLAVE@localhost:3306/aula_imc_test"

# Secreto para firmar los tokens de acceso: al menos 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# Duración del token de acceso (segundos). Aprobado: 15 minutos.
JWT_ACCESS_TTL_SECONDS=900
# Duración máxima de una sesión renovable (días). Aprobado: 7 días.
REFRESH_TTL_DAYS=7

# Cookie de renovación. En producción COOKIE_SECURE debe ser true.
COOKIE_SECURE=false
# strict | lax | none (none exige COOKIE_SECURE=true)
COOKIE_SAMESITE=strict

# Origen permitido para el frontend (CORS). Varios, separados por comas.
CORS_ORIGIN=http://localhost:4200

# Bloqueo por intentos fallidos. Aprobado: 5 intentos, 15 minutos.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Límite de solicitudes por IP: general y para inicio de sesión y renovación.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
# Renovación de sesión: por sesión y techo por IP (redes compartidas). Las solicitudes inválidas usan AUTH_THROTTLE_LIMIT.
REFRESH_SESSION_LIMIT=30
REFRESH_IP_LIMIT=600

# true solo si la API está detrás de un proxy inverso de confianza (para obtener la IP real).
TRUST_PROXY=false

# Documentación Swagger en /api/docs. Siempre desactivada en producción.
SWAGGER_ENABLED=true

# Semilla de demostración (npm run db:seed): SOLO en desarrollo. Ponerla en true únicamente en la base local
# aula_imc_dev. En producción debe ser false (la API no arranca si es true).
SEED_DEMO_ALLOWED=false
# Contraseña de las cuentas de demostración creadas por la semilla (solo desarrollo).
SEED_DEMO_PASSWORD=demo1234

# Activación de cuentas de estudiantes (B2.3c). Pantalla de activación del frontend: el enlace es
# <ACTIVATION_URL>#token=<token>. URL válida, sin «#»; https en producción. Sin ella no se emite ningún enlace.
ACTIVATION_URL=http://localhost:4200/activar-cuenta
# Vigencia del enlace de activación en horas (por defecto 72; de 1 a 336).
ACTIVATION_TOKEN_TTL_HOURS=72
# SOLO DESARROLLO LOCAL: true escribe el enlace de activación en la consola del backend en lugar de enviar un correo
# (la respuesta indica emailDelivery "DEV_CONSOLE"; nunca se simula un correo enviado). Requiere ACTIVATION_URL.
# En producción debe ser false: la API no arranca si es true con NODE_ENV=production.
MAIL_DEV_CONSOLE=false

# Portadas de curso subidas por el Instructor (JPG, PNG o WebP; máximo 2 MB). Carpeta base de los archivos: las
# portadas se guardan en <UPLOADS_DIR>/course-covers/ y en MySQL solo queda su ruta (/api/v1/public/course-covers/...).
# Opcional: sin valor se usa "storage" (relativa a la carpeta backend). Esta carpeta no se versiona en Git y debe
# incluirse en los respaldos junto con la base de datos.
# UPLOADS_DIR=storage
